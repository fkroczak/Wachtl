# Wachtl – Server-Konfiguration. setup.sh legt daraus .env an und füllt Geheimnisse automatisch.

# Adresse, unter der Probes und Browser den Server erreichen (DNS-Name oder IP)
WACHTL_HOST=wachtl.kunde.local
WACHTL_PUBLIC_URL=https://wachtl.kunde.local

# Wird von setup.sh erzeugt – nicht von Hand ändern
WACHTL_SECRET_KEY=
WACHTL_WEBHOOK_SECRET=
WACHTL_SPKI_PIN=
POSTGRES_PASSWORD=
WACHTL_INITIAL_ADMIN_PASSWORD=

# iperf3-Gegenstelle für Bandbreitenmessungen der Probes (TCP und UDP).
# Abschalten: im Web-UI unter Verwaltung › Messung und „docker compose stop iperf3“.
IPERF_PORT=5201

# Server-Probe: der Server misst selbst mit denselben Checks wie die Probes (1 = an, 0 = aus)
SERVER_PROBE=1

# Aufbewahrung: Rohdaten (z. B. 7d, 30d) und Aggregate (Monate)
RAW_RETENTION=30d
AGG_RETENTION=13

# Benachrichtigungen – nur für die Ersteinrichtung, danach im Web-UI unter Verwaltung › Benachrichtigungen
# E-Mail-Alarme (leer lassen = aus)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=wachtl@kunde.local
SMTP_SMARTHOST=mail.kunde.local:587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true

# Microsoft Teams: URL eines Workflows "Bei Empfang einer Teams-Webhookanforderung posten" (leer = aus)
TEAMS_WEBHOOK_URL=

# Versionen (bei Updates hier anheben)
VM_VERSION=v1.149.0
ALERTMANAGER_VERSION=v0.28.1
TRAEFIK_VERSION=v3.3
POSTGRES_VERSION=16-alpine
